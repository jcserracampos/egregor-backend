<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={Plug.CSRFProtection.get_csrf_token()} />
    <title>Egrégor</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Inter:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href={~p"/css/web.css"} />
  </head>
  <body>
    <%= @inner_content %>
    <script src={~p"/js/vendor/phoenix.js"}></script>
    <script src={~p"/js/vendor/phoenix_live_view.js"}></script>
    <script src={~p"/js/web.js"}></script>
  </body>
</html>
